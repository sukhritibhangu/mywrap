PORT=5000
NODE_ENV=development
TRUST_PROXY_HOPS=0
CORS_ORIGIN=

MONGO_URI=mongodb://127.0.0.1:27017/wrapchik

JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRE=7d

# Local-only email OTP fallback: returns a short-lived code only to the development app.
# Must remain false outside NODE_ENV=development.
LOCAL_OTP_ENABLED=false

# Optional development-only generic sample menu. Keep false to use the real Wrapchik catalogue.
SEED_SAMPLE_CATALOGUE=false

# Legacy Cashfree settings are retained for historical orders only. New checkout does not use a payment gateway.
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2026-01-01
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_WEBHOOK_SECRET=
APP_PUBLIC_URL=

# Legacy gateway values are retained for existing Razorpay orders during migration only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional Resend fallback. New local setup uses Gmail SMTP below.
RESEND_API_KEY=
# Used only with Resend; its sender must belong to a verified domain.
EMAIL_FROM=

# Preferred temporary free delivery: Gmail SMTP (requires Google 2-Step Verification + an App Password).
# When set, Gmail SMTP is used instead of Resend. Never use your regular Gmail password here.
SMTP_USER=
SMTP_APP_PASSWORD=

# Optional Expo push access token. A provider ticket still does not prove device delivery.
EXPO_ACCESS_TOKEN=

# Public Google OAuth Web client ID. Enables Thapar-only Google student sign-in.
# Authorized JavaScript origin: https://wrapchik.onrender.com
# No Google client secret or Gmail SMTP is needed for Google sign-in.
GOOGLE_CLIENT_ID=
